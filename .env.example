# ============================================================
# QueueLess — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Database (PostgreSQL — Neon recommended) ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Authentication ----
BETTER_AUTH_SECRET="generate-a-strong-random-secret-here"
BETTER_AUTH_URL=http://localhost:3000

# ---- Email (Resend) ----
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# ---- Payment Gateway (Razorpay) ----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe alternative (uncomment if using Stripe instead)
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
# STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ---- Realtime (Supabase — optional) ----
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---- SMS (Twilio — optional) ----
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# ---- Commission ----
DEFAULT_COMMISSION_RATE_PERCENT=10
DEFAULT_CURRENCY=INR

# ---- File Upload ----
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
